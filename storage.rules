rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Photos: only the owning trainee can upload to their own folder, up to 5MB, images only.
    match /photos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Theme songs: only the owning trainee can upload to their own folder, up to 10MB, audio only.
    match /theme-songs/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }
  }
}

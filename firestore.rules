rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return isSignedIn() && myRole() == 'admin'; }
    // 'trainer' is kept as a legacy alias so existing accounts created before the
    // coach rename keep working without any manual data migration.
    function isCoachOrAdmin() { return isSignedIn() && (myRole() == 'coach' || myRole() == 'trainer' || myRole() == 'admin'); }

    // users/{uid} -- account + contact info
    match /users/{uid} {
      // trainees/coaches/admins can read their own doc; coaches/admins can read everyone's
      allow read: if isSignedIn() && (request.auth.uid == uid || isCoachOrAdmin());

      // self-registration is only ever allowed to create a TRAINEE account.
      // coach/admin accounts are created server-side (Admin SDK bypasses these rules).
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == 'trainee';

      // a user can edit their own contact info, but can never change their own role
      allow update: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;

      // only admins can delete accounts, and only via the client for other users
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // profiles/{uid} -- the wrestling character sheet
    match /profiles/{uid} {
      // trainee sees only their own profile; coaches/admins see everyone's
      allow read: if isSignedIn() && (request.auth.uid == uid || isCoachOrAdmin());
      // only the owning trainee can create/edit their own profile
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // shows/{showId} -- a show roster. participantUids is a denormalized union of
    // every match's participants on this show, kept in sync by the client whenever
    // matches are added/edited/deleted. It's what lets a trainee see only shows
    // they're actually booked on.
    match /shows/{showId} {
      allow read: if isCoachOrAdmin()
                  || (isSignedIn() && request.auth.uid in resource.data.participantUids);
      allow create, update, delete: if isCoachOrAdmin();

      // shows/{showId}/matches/{matchId} -- individual matches on the card.
      // A trainee who can see the show (i.e. is booked somewhere on it) can see
      // every match on that card, not just their own -- same as a real card sheet.
      match /matches/{matchId} {
        allow read: if isCoachOrAdmin()
                    || (isSignedIn()
                        && request.auth.uid in get(/databases/$(database)/documents/shows/$(showId)).data.participantUids);
        allow create, update, delete: if isCoachOrAdmin();
      }
    }
  }
}
